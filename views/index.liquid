{% layout 'layouts/base.liquid' %}
{% block content %}

<h1 class="page-title">All Pokémon</h1>

<search>
  <label class="search-label" for="search">Look up Pokémon</label>
  <form class="search" action="/" method="get">
    <input type="search" name="search" id="search" placeholder="Search">
    <button class="search-button" type="submit">Submit</button>
  </form>
</search>
  
<a class="favorite-link" href="/favorites">Favorites 
  <img class="favorite-button" src="/assets/pokeball.svg" alt="" width="30" height="30">
</a>

<section class="pokemon-grid">
  {% for item in pokemon %}
    {% render 'partials/pokemon-card.liquid', item: item, index: forloop.index %}
  {% else %}
    <article class="empty-state">No Pokémon found</article>
  {% endfor %}
</section>

{% endblock %}

