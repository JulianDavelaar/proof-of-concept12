{% render 'partials/head.liquid' %}

<main class="detail">
    <a href="/" class="back-link">Terug naar overzicht</a>

<article class="card type-{{ pokemon.type }}">

    <header class="card-top">
        <h1 class="card-name">{{ pokemon.name }}</h1>
        <span class="hp"> HP {{ pokemon.stats[0].base_stat }}</span>
    </header>

    <div class="card-window">
        <picture>
            <source type="image/webp" srcset="{{ pokemon.image }}">
            <img src="{{ pokemon.image }}" alt="{{ pokemon.name }}" width="150" height="150" >
        </picture>
    </div>

    <ul class="detail-types">
        {% for type in pokemon.types %}
            <li>{{ type.type.name }}</li>
        {% endfor %}
    </ul>

    <section class="detail-stats">
        <h2>Stats</h2>
          <ul>
            {%  for stat in pokemon.stats %}
                <li><span>{{ stat.stat.name }}</span> <span>{{ stat.base_stat }}</span></li>
            {% endfor %}
        </ul>
    </section>

</article>

</main>
{% render 'partials/foot.liquid' %}
