{% layout 'layouts/base.liquid' %}
{% block content %}

<main class="detail">

<a href="/" class="back-link">Back</a>

<article class="card type-{{ pokemon.type }}">

    
  <div class="card-top">
    <h1 class="card-name">{{ pokemon.name }}</h1>
    <span class="hp"> HP {{ pokemon.stats[0].base_stat }}</span>
  </div>

  <div class="card-window">

    <form class="favorite-form" action="/pokemon/{{ pokemon.id }}/favorite" method="post">
      <button type="submit" class="favorite-button">
        <img src="/assets/pokeball.svg" alt="add to favorites" width="50" height="50">
      </button>
    </form>

    <picture>
      <source type="image/gif" srcset="{{ pokemon.image }}">  
      <img src="{{ pokemon.image }}" alt="{{ pokemon.name }}" width="150" height="150" >
    </picture>
  </div>

  <ul class="detail-types">
    {% for type in pokemon.types %}
      <li>{{ type.type.name }}</li>
    {% endfor %}
  </ul>

<section class="detail-stats">
  <h2>Stats</h2>
    <dl class="detail-stats-list">
      {%  for stat in pokemon.stats %}
        <div class="stat-row">
          <dt class="stat-name">{{ stat.stat.name }}</dt> 
          <dd class="stat-value">{{ stat.base_stat }}
            <div class="stat-bar">
              <div class="stat-fill" style="width:{{ stat.base_stat }}%">
              </div>
            </div>
          </dd>
        </div>
      {% endfor %}
    </dl>
  </section>
</article>
</main>


{% endblock %}