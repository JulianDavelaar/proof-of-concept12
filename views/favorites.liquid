{% layout 'layouts/base.liquid' %}
{% block content %}

<main>

<h1 class="page-title">My favorite pokémon</h1>

<a href="/" class="back-link">Back</a>


<div class="pokemon-grid favorite-grid">
  {% for item in pokemon %}
    {% render 'partials/pokemon-card.liquid', item: item, index: forloop.index %}
  {% else %}
    <article class="empty-state">No favorites yet - go catch some!</article>
  {% endfor %}
</div>

</main>

{% endblock %}